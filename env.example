# ===========================================
# Sunmarke Voice RAG - Environment Variables
# ===========================================

# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env to version control

# -------------------------------------------
# AI Model API Keys
# -------------------------------------------

# Google Gemini API Key
# Get from: https://ai.google.dev/
# Free tier: 60 requests/minute, 1,500 requests/day
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API Key (for Mixtral and Llama models)
# Get from: https://console.groq.com/keys
# Free tier: 30 requests/minute, 14,400 requests/day
GROQ_API_KEY=your_groq_api_key_here

# Third model uses same Groq API (for Llama 3.3)
# Use the SAME value as GROQ_API_KEY above
DEEPSEEK_API_KEY_G=your_groq_api_key_here

# -------------------------------------------
# Vector Database (Pinecone)
# -------------------------------------------

# Pinecone API Key
# Get from: https://www.pinecone.io/
# Free tier: 1 index, 100K vectors
PINECONE_API_KEY=your_pinecone_api_key_here

# Pinecone Index Name
# Create this index before running the application
# Dimension: 1024 (for Cohere embeddings)
# Metric: cosine
PINECONE_INDEX_NAME=sunmarke-rag

# -------------------------------------------
# Embeddings (Cohere)
# -------------------------------------------

# Cohere API Key
# Get from: https://cohere.com/
# Free tier: 100 API calls/minute
COHERE_API_KEY=your_cohere_api_key_here

# Cohere Embedding Model
# Default: embed-english-v3.0 (1024 dimensions, free tier)
COHERE_MODEL=embed-english-v3.0

# -------------------------------------------
# RAG Configuration
# -------------------------------------------

# Number of document chunks to retrieve for context
# Higher = more context but slower responses
# Recommended: 3-5
TOP_K=4

# -------------------------------------------
# Server Configuration
# -------------------------------------------

# Enable auto-reload during development
# Set to 'false' for production
RELOAD=true

# -------------------------------------------
# Optional: Advanced Configuration
# -------------------------------------------

# Embedding model for vector database (if using local embeddings)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector database directory (if using Chroma locally)
# VECTOR_DB_DIR=data/vector_db

# -------------------------------------------
# Notes
# -------------------------------------------

# 1. All API keys above are required for full functionality
# 2. DEEPSEEK_API_KEY_G should use your GROQ_API_KEY value
# 3. Never commit .env file to Git
# 4. Keep API keys secure and rotate regularly
# 5. Monitor API usage to stay within free tier limits

# -------------------------------------------
# Free Tier Limits Summary
# -------------------------------------------

# Service          | Requests/Min | Requests/Day | Cost
# -----------------|--------------|--------------|------
# Gemini           | 60           | 1,500        | FREE
# Groq             | 30           | 14,400       | FREE
# Pinecone         | N/A          | N/A          | FREE (1 index)
# Cohere           | 100          | N/A          | FREE
# TOTAL MONTHLY COST: $0 ✅
